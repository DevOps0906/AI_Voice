  "learned": [
    {
      "concept": "푸리에 급수",
      "summary": "주기적인 소리 = 배음의 합",
      "code": "$x(t) = \\sum_k A_k \\sin(2\\pi k f_0 t + \\phi_k)$"
    },
    {
      "concept": "포먼트",
      "summary": "성도가 만드는 봉우리, 모음을 결정",
      "code": "$A_k \\approx G(k f_0)$"
    },
    {
      "concept": "DFT",
      "summary": "시험 사인파와 곱해서 더하기",
      "code": "$X[k] = \\sum_n x[n] e^{-j2\\pi kn/N}$"
    },
    {
      "concept": "bin 주파수",
      "summary": "$k$번째 칸의 Hz",
      "code": "$f_k = k f_s / N$, 진폭 $A = 2\\lvert X[k]\\rvert/N$"
    },
    {
      "concept": "FFT",
      "summary": "DFT와 같은 결과, 빠른 계산",
      "code": "$N^2 \\to N\\log_2 N$"
    },
    {
      "concept": "해상도",
      "summary": "길게 볼수록 촘촘",
      "code": "$\\Delta f = f_s / N$"
    },
    {
      "concept": "창 함수",
      "summary": "leakage 줄이기",
      "code": "$w[n] = 0.5 - 0.5\\cos(2\\pi n/(N-1))$"
    },
    {
      "concept": "STFT",
      "summary": "짧게 잘라 FFT",
      "code": "$X[m,k] = \\sum_n x[n+mH] w[n] e^{-j2\\pi kn/N}$, $M = 1 + \\lfloor L/H \\rfloor$"
    },
    {
      "concept": "트레이드오프",
      "summary": "시간과 주파수를 동시에 선명하게 볼 수 없다",
      "code": "$(N/f_s)(f_s/N) = 1$"
    },
    {
      "concept": "Mel",
      "summary": "귀에 맞춘 주파수 축",
      "code": "$m = 2595\\log_{10}(1 + f/700)$, $\\mathbf{H}\\lvert X\\rvert^2$"
    },
    {
      "concept": "MFCC",
      "summary": "Log-Mel의 DCT 앞 13개 = 봉우리 모양",
      "code": "$c_n = \\sum_m \\log \\text{Mel}_m \\cos[\\pi n(m+0.5)/M]$"
    }
  ],
