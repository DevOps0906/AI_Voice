  "learned": [
    {
      "concept": "Fine-tuning",
      "summary": "사전학습 모델을 우리 데이터로 조금 더 학습",
      "code": "WhisperForConditionalGeneration.from_pretrained(...)"
    },
    {
      "concept": "Teacher forcing",
      "summary": "정답 앞부분을 보고 다음 토큰 맞히기, loss = −log P(정답)",
      "code": "model(input_features=..., labels=...)"
    },
    {
      "concept": "set_transform",
      "summary": "꺼낼 때마다 특징 · 토큰 만들기",
      "code": "ds.set_transform(prepare_batch)"
    },
    {
      "concept": "Data Collator",
      "summary": "묶음 만들기, 패딩 → −100, 시작 토큰 빼기",
      "code": "masked_fill(mask.ne(1), -100)"
    },
    {
      "concept": "compute_metrics",
      "summary": "생성 → 글자 → 정규화 → CER",
      "code": "jiwer.cer(label_str, pred_str)"
    },
    {
      "concept": "학습 설정",
      "summary": "lr 1e-5 · warmup · 8×2 · fp16 · 생성 평가",
      "code": "Seq2SeqTrainingArguments(...)"
    },
    {
      "concept": "Trainer",
      "summary": "반복 학습 · 평가 · 저장을 대신",
      "code": "Seq2SeqTrainer(..., data_collator=collator)"
    },
    {
      "concept": "모니터링",
      "summary": "곡선으로 과적합 · 학습률 문제 읽기",
      "code": "%tensorboard, trainer.state.log_history"
    },
    {
      "concept": "저장 · 추론",
      "summary": "모델 + processor 한 폴더 → pipeline",
      "code": "save_model, save_pretrained, pipeline(...)"
    }
  ],
