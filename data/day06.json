  "learned": [
    {
      "concept": "정렬 문제",
      "summary": "프레임 $T \\gg$ 글자 $U$, 정렬 라벨 없음",
      "code": "$\\hat Y = \\arg\\max_Y P(Y \\mid X)$"
    },
    {
      "concept": "CTC 접기",
      "summary": "반복 합치기 → blank 지우기",
      "code": "$\\mathcal{B}(\\texttt{hhe-ll-lloo}) = \\texttt{hello}$"
    },
    {
      "concept": "CTC 확률",
      "summary": "정답으로 접히는 경로를 모두 더함",
      "code": "$\\sum_{\\pi \\in \\mathcal{B}^{-1}(Y)} \\prod_t p_t(\\pi_t)$"
    },
    {
      "concept": "경로 수",
      "summary": "연속 중복 없을 때",
      "code": "$\\binom{T+U}{2U}$"
    },
    {
      "concept": "forward α",
      "summary": "확장 라벨 $2U+1$, 두 칸 건너뛰기 조건",
      "code": "$l'_s \\ne \\epsilon,\\; l'_s \\ne l'_{s-2}$"
    },
    {
      "concept": "Wav2Vec2 프레임",
      "summary": "보폭 320 (20 ms), 수용 영역 400 (25 ms)",
      "code": "$T = \\lfloor (L - 400)/320 \\rfloor + 1$"
    },
    {
      "concept": "greedy 디코딩",
      "summary": "프레임마다 argmax → 접기",
      "code": "logits.argmax(-1) → ctc_collapse"
    },
    {
      "concept": "타임스탬프",
      "summary": "스파이크 프레임 × 0.02 s",
      "code": "t * S_TOT / SR"
    },
    {
      "concept": "AED",
      "summary": "연쇄 법칙, 한 토큰씩",
      "code": "$\\prod_u P(y_u \\mid y_{<u}, X)$"
    },
    {
      "concept": "attention",
      "summary": "스케일 내적",
      "code": "$\\text{softmax}(QK^\\top/\\sqrt{d_k})V$"
    },
    {
      "concept": "Transducer",
      "summary": "격자: ∅ → 오른쪽, 글자 → 위",
      "code": "$\\alpha(t,u) = \\alpha(t-1,u)\\varnothing + \\alpha(t,u-1) y$"
    },
    {
      "concept": "wav2vec 2.0",
      "summary": "마스킹 · 양자화 · 대조",
      "code": "$1-(1-p)^M \\approx 0.49$, InfoNCE ($\\kappa = 0.1$)"
    },
    {
      "concept": "HuBERT",
      "summary": "k-means 가짜 라벨 예측",
      "code": "$-\\sum_{t \\in \\mathcal{M}} \\log p(z_t \\mid \\tilde X)$"
    }
  ],
