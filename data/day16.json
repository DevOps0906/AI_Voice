      "code": "code // 588"
    },
    {
      "concept": "G2P",
      "summary": "연음 · 경음화 · 비음화 · 구개음화 …",
      "code": "linking(), G2p()"
    },
    {
      "concept": "mel · 프레임",
      "summary": "프레임 ≈ 샘플 ÷ hop (16 kHz · 256 → 62.5/초)",
      "code": "librosa.feature.melspectrogram"
    },
    {
      "concept": "Duration",
      "summary": "기호마다 프레임 수 → 복사해 늘이기",
      "code": "np.repeat(enc, durations, axis=0)"
    },
    {
      "concept": "Vocoder",
      "summary": "mel → 파형, 업샘플 곱 = hop",
      "code": "SpeechT5HifiGan, upsample_rates"
    },
    {
      "concept": "VITS",
      "summary": "인코더 + duration + flow + HiFi-GAN 한 몸",
      "code": "VitsModel, speaking_rate, noise_scale"
    },
    {
      "concept": "ASR 역검증",
      "summary": "합성음을 받아써서 CER로 '알아듣기 쉬움' 재기",
      "code": "jiwer.cer(for_cer(ref), for_cer(hyp))"
    }
  ],
