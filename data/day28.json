  "learned": [
    {
      "concept": "VAD `stop_secs`",
      "summary": "쉼을 견디게 하지만 모든 턴이 느려짐 → 0.2초 두고 턴 판단에서 기다리기",
      "code": "VADParams(stop_secs=0.2)"
    },
    {
      "concept": "VAD `min_volume`",
      "summary": "작은 배경 목소리(TV) 무시, 너무 올리면 작은 목소리를 놓침",
      "code": "VADParams(min_volume=0.75)"
    },
    {
      "concept": "Speech Timeout",
      "summary": "말 끝 뒤 N초 조용하면 턴 끝 (시계)",
      "code": "SpeechTimeoutUserTurnStopStrategy(user_speech_timeout=0.6)"
    },
    {
      "concept": "Smart Turn",
      "summary": "소리의 말끝 억양으로 '끝냈나' 확률 (말투)",
      "code": "TurnAnalyzerUserTurnStopStrategy(turn_analyzer=LocalSmartTurnAnalyzerV3())"
    },
    {
      "concept": "Interruption",
      "summary": "턴 시작 → `InterruptionFrame` → 모두 멈춤 → 말한 만큼만 기록",
      "code": "InterruptionFrame"
    },
    {
      "concept": "끼어들기 끄기",
      "summary": "턴은 처리하되 비서 말을 끊지 않음",
      "code": "VADUserTurnStartStrategy(enable_interruptions=False)"
    },
    {
      "concept": "Mute",
      "summary": "첫 발화(녹취 고지)가 끝날 때까지 사용자 입력 무시",
      "code": "MuteUntilFirstBotCompleteUserMuteStrategy()"
    },
    {
      "concept": "Metrics",
      "summary": "서비스별 TTFB · 처리 시간 · 사용량",
      "code": "PipelineParams(enable_metrics=True) · MetricsFrame"
    },
    {
      "concept": "직접 만든 서비스",
      "summary": "start → stop 짝으로 TTFB 보고",
      "code": "start_ttfb_metrics() · stop_ttfb_metrics()"
    },
    {
      "concept": "전체 지연",
      "summary": "턴마다 사용자 말 끝 → 봇 첫 소리",
      "code": "UserBotLatencyObserver · on_latency_measured"
    }
  ],
  "homework": [
