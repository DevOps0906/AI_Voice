  "learned": [
    {
      "concept": "Speech Commands",
      "summary": "1초 · 16 kHz · 35단어, 화자 기준 분할",
      "code": "torchaudio.datasets.SPEECHCOMMANDS"
    },
    {
      "concept": "1초 맞추기",
      "summary": "짧으면 0 채우기, 길면 자르기",
      "code": "np.pad(y, (0, n - len(y)))"
    },
    {
      "concept": "입력 특징",
      "summary": "Log-Mel 64 × 101",
      "code": "$M = 1 + \\lfloor 16000/160 \\rfloor = 101$"
    },
    {
      "concept": "정규화",
      "summary": "학습 세트 기준, 예측에도 같은 값",
      "code": "$\\hat x = (x - \\mu)/\\sigma$"
    },
    {
      "concept": "합성곱",
      "summary": "필터와 곱해서 더하기",
      "code": "$y = b + \\sum w \\cdot x$"
    },
    {
      "concept": "출력 크기",
      "summary": "커널 · 패딩 · 보폭",
      "code": "$\\lfloor (H + 2P - K)/S \\rfloor + 1$"
    },
    {
      "concept": "파라미터 수",
      "summary": "conv · linear",
      "code": "$C_{in} C_{out} K^2 + C_{out}$, $d_{in} d_{out} + d_{out}$"
    },
    {
      "concept": "softmax",
      "summary": "점수 → 확률",
      "code": "$p_k = e^{z_k} / \\sum_j e^{z_j}$"
    },
    {
      "concept": "cross-entropy",
      "summary": "정답 확률의 −log",
      "code": "$\\mathcal{L} = -\\log p_y$, $\\partial\\mathcal{L}/\\partial z = p - \\text{onehot}$"
    },
    {
      "concept": "경사 하강법",
      "summary": "기울기 반대로 한 걸음",
      "code": "$\\theta \\leftarrow \\theta - \\eta \\nabla\\mathcal{L}$"
    },
    {
      "concept": "학습 루프",
      "summary": "네 줄",
      "code": "forward → loss → backward() → step()"
    },
    {
      "concept": "혼동 행렬",
      "summary": "정답 × 예측",
      "code": "precision = 열 기준, recall = 행 기준"
    },
    {
      "concept": "SpecAugment",
      "summary": "주파수 · 시간 가리기",
      "code": "T.FrequencyMasking, T.TimeMasking"
    }
  ],
