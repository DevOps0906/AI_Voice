  "learned": [
    {
      "concept": "Streaming",
      "summary": "다 모으지 않고 20 ms 조각으로 흘려보낸다",
      "code": "FRAME = SR * FRAME_MS / 1000"
    },
    {
      "concept": "비트레이트",
      "summary": "샘플링 레이트 × 비트 × 채널",
      "code": "PCM16 16 kHz = 256 kbps"
    },
    {
      "concept": "지터 · 버퍼",
      "summary": "늦은 조각은 버리고 메운다, 버퍼 = 끊김 ↔ 지연 맞바꿈",
      "code": "deadline = send + delay_ms"
    },
    {
      "concept": "적응형 버퍼",
      "summary": "지난 지연의 높은 백분위로",
      "code": "np.percentile(obs, 95)"
    },
    {
      "concept": "TCP vs UDP",
      "summary": "TCP는 빠짐 없이 늦게, UDP는 제때 빠짐 있게",
      "code": "head-of-line blocking"
    },
    {
      "concept": "Opus",
      "summary": "20 ms · 6 ~ 64 kbps · 음성은 16 ~ 32 kbps면 받아쓰기 유지",
      "code": "enc.bit_rate = kbps * 1000"
    },
    {
      "concept": "WebSocket",
      "summary": "바이너리 조각 + JSON 이벤트, 서버 ↔ 서버에 적합",
      "code": "ws.send(chunk.tobytes())"
    },
    {
      "concept": "WebRTC",
      "summary": "offer · answer · ICE · DTLS · RTP, 사람 쪽 구간에 적합",
      "code": "setRemoteDescription(pc1.localDescription)"
    },
    {
      "concept": "대역폭",
      "summary": "(코덱 + 머리말) × 2 × 통화 수",
      "code": "100통화 Opus 24k ≈ 8 Mbps"
    }
  ],
