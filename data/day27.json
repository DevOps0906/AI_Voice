  "learned": [
    {
      "concept": "Frame",
      "summary": "모든 것은 상자: System(즉시) · Data · Control(순서대로)",
      "code": "isinstance(f, DataFrame)"
    },
    {
      "concept": "FrameProcessor",
      "summary": "부모 먼저 → 내 일 → 무조건 넘기기",
      "code": "await super().process_frame(...) · await self.push_frame(...)"
    },
    {
      "concept": "방향",
      "summary": "내용은 앞 → 뒤, 뒤쪽 사정 알림은 뒤 → 앞",
      "code": "FrameDirection.UPSTREAM"
    },
    {
      "concept": "Worker · Runner",
      "summary": "라인 반장 · 공장장 (옛 이름 Task · Runner)",
      "code": "PipelineWorker · WorkerRunner"
    },
    {
      "concept": "Observer",
      "summary": "파이프라인을 바꾸지 않고 모든 push 기록",
      "code": "on_push_frame(data)"
    },
    {
      "concept": "STT 서비스",
      "summary": "VAD 구간 소리 → 받아쓰기 → yield",
      "code": "yield TranscriptionFrame(...)"
    },
    {
      "concept": "TTS 서비스",
      "summary": "문장 → 합성, 루프를 막지 않기",
      "code": "await asyncio.to_thread(tts, ...)"
    },
    {
      "concept": "LLM 서비스",
      "summary": "대화 전체를 받아 조각으로 답",
      "code": "LLMContextFrame → LLMTextFrame…"
    },
    {
      "concept": "Aggregator",
      "summary": "턴 끝 판단 + 대화 기록 자동",
      "code": "LLMContextAggregatorPair (assistant는 맨 끝)"
    },
    {
      "concept": "Transport · Serializer",
      "summary": "바깥과 잇는 문 · 번역기, 바꿔 끼워도 안쪽은 그대로",
      "code": "transport.input() · transport.output()"
    }
  ],
