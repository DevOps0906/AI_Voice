  "learned": [
    {
      "concept": "API 공통 구조",
      "summary": "모델 · 시스템 지시 · 대화 목록 · 길이 상한 · Streaming",
      "code": "ask(provider, system, messages)"
    },
    {
      "concept": "키 관리",
      "summary": "보안 비밀 · 환경 변수 · 출력 · 커밋 금지 · 유출 시 폐기",
      "code": "secret(\"ANTHROPIC_API_KEY\")"
    },
    {
      "concept": "Claude Streaming",
      "summary": "글 조각 반복자",
      "code": "s.text_stream"
    },
    {
      "concept": "OpenAI Streaming",
      "summary": "이벤트 중 글 조각",
      "code": "response.output_text.delta"
    },
    {
      "concept": "Gemini 역할",
      "summary": "비서 = model",
      "code": "{\"role\": \"model\"}"
    },
    {
      "concept": "비용",
      "summary": "입력 × 단가 + 출력 × 단가",
      "code": "pr[\"out\"]"
    },
    {
      "concept": "비교",
      "summary": "중앙값 + 최댓값",
      "code": ".median()"
    },
    {
      "concept": "음성 프롬프트",
      "summary": "짧게 · 결론 먼저 · 기호 금지 · 되묻기 · 모르면 모른다고",
      "code": "voice_lint(..., max_sent)"
    },
    {
      "concept": "대화 이력",
      "summary": "최근 N턴(쌍) + 요약 + 말한 데까지만",
      "code": "turns[-N * 2:], reply[:spoken], commit()"
    }
  ],
